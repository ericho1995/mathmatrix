# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Kill switch ────────────────────────────────────────────────────────────────
# Set to "true" (and redeploy) to take the whole site down to a maintenance page.
MAINTENANCE_MODE=false

# ─── PDF previews ───────────────────────────────────────────────────────────────
# Let visitors who haven't paid download about the first third of a paper and
# its answers, ending with a page listing what the rest holds. Customers always
# get full papers. Off unless set to "on"; change in Vercel, then redeploy.
# See src/lib/pdf/previewPolicy.ts.
# PDF_PREVIEW_PAID=on           # every paid paper offers a free preview
# PDF_PREVIEW_FREE_SAMPLES=on   # the free sample papers become previews

# Shown in the footer, help centre and account page. No default on purpose — an
# address nobody reads is worse than none. Leave unset and contact lines hide.
# NEXT_PUBLIC_SUPPORT_EMAIL=help@example.com

# ─── Payments (Stripe) ─────────────────────────────────────────────────────────
# Without these the checkout and webhook routes return 503 and every premium
# paper stays locked — the app still runs, it just cannot take money.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. The webhook refuses to process anything without it.
STRIPE_WEBHOOK_SECRET=whsec_...

# One Stripe Price per year-level bundle. The client never sends a price — it
# names a year level and the id is looked up here server-side.
STRIPE_PRICE_GRADE_3=price_...
STRIPE_PRICE_GRADE_4=price_...
STRIPE_PRICE_GRADE_5=price_...
STRIPE_PRICE_GRADE_6=price_...
STRIPE_PRICE_YEAR_7=price_...
STRIPE_PRICE_YEAR_8=price_...
STRIPE_PRICE_YEAR_9=price_...
STRIPE_PRICE_YEAR_10=price_...
STRIPE_PRICE_YEAR_11=price_...
# Optional. Year 12 becomes buyable the moment this exists; until then its
# buy buttons read "purchases open soon".
# STRIPE_PRICE_YEAR_12=price_...

# ─── Supabase service role ─────────────────────────────────────────────────────
# Settings > API > service_role. Server-only — never expose this to the client.
# The Stripe webhook needs it to write entitlements, because row-level security
# deliberately gives the client no way to grant itself one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Ad measurement (optional) ─────────────────────────────────────────────────
# With a pixel id set, a cookie notice asks visitors first; the pixel loads only
# for those who choose Allow. Without them nothing loads and no notice shows.
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=ABCDEF1234567890
# Meta Events Manager > the pixel > Settings > Conversions API > access token.
# Purchases are then also sent from the server (with the buyer's consent).
# META_CAPI_TOKEN=EAAB...

# ─── Alerts (optional) ─────────────────────────────────────────────────────────
# Emails you when a payment can't be recorded or visitors hit errors. Uses a
# Resend API key; ALERT_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_...
# ALERT_EMAIL=you@example.com
# ALERT_FROM=PrepNest alerts <alerts@prepnest.com.au>
