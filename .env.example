# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Kill switch ────────────────────────────────────────────────────────────────
# Set to "true" (and redeploy) to take the whole site down to a maintenance page.
MAINTENANCE_MODE=false

# ─── Payments (Stripe) ─────────────────────────────────────────────────────────
# Without these the checkout and webhook routes return 503 and every premium
# paper stays locked — the app still runs, it just cannot take money.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. The webhook refuses to process anything without it.
STRIPE_WEBHOOK_SECRET=whsec_...

# One Stripe Price per year-level bundle. The client never sends a price — it
# names a year level and the id is looked up here server-side.
STRIPE_PRICE_GRADE_3=price_...
STRIPE_PRICE_GRADE_4=price_...
STRIPE_PRICE_GRADE_5=price_...
STRIPE_PRICE_GRADE_6=price_...
STRIPE_PRICE_YEAR_7=price_...
STRIPE_PRICE_YEAR_8=price_...
STRIPE_PRICE_YEAR_9=price_...
STRIPE_PRICE_YEAR_10=price_...
STRIPE_PRICE_YEAR_11=price_...

# ─── Supabase service role ─────────────────────────────────────────────────────
# Settings > API > service_role. Server-only — never expose this to the client.
# The Stripe webhook needs it to write entitlements, because row-level security
# deliberately gives the client no way to grant itself one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
